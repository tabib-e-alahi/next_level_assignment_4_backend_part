model OrderItem {
  id String @id @default(uuid())

  orderId String
  mealId  String
  categoryId String

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  meal  Meals @relation(fields: [mealId], references: [id])
  category  Category @relation(fields: [categoryId], references: [id])

  quantity  Int
  unitPrice Int
  reviews   Reviews[]

  @@index([orderId])
  @@index([mealId])
}
