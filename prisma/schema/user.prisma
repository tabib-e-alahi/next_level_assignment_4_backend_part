model User {
      id        String   @id @default(uuid())
      name      String
      email     String   @unique
      password  String
      role      Role     @default(CUSTOMER)
      status    Status   @default(ACTIVE)
      phone     String?
      createdAt DateTime @default(now())
      updatedAt DateTime @updatedAt

      //* relations
      providerProfiles ProviderProfile? //* here I set that one user can have only one proiver profile
      orders           Order[]
      reviews          Reviews[]

      @@index([email])
      @@map("user")
}

enum Role {
      CUSTOMER
      PROVIDER
      ADMIN
}

enum Status {
      ACTIVE
      SUSPENDED
}
