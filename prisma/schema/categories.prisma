model Category {
      id          String   @id @default(uuid())
      name        String   @unique
      slug        String?  @unique
      description String?
      logo        String?
      createdAt   DateTime @default(now())
      updatedAt   DateTime @updatedAt

      //* relations
      meals      Meals[]
      orderItems OrderItem[]

      @@index([name])
      @@map("mealCatagories")
}
